---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumbs from "@/components/Breadcrumb.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`Personal | ${config.site.title}`}>
  <Header activeNav="personal" />
  <Breadcrumbs />
  <Main
    pageTitle="Personal"
    pageDesc="A collection of personal interests and ongoing activities."
  >
    <ul class="space-y-4">
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "thoughts")}
          class="text-accent text-lg font-medium hover:underline"
        >
          Thoughts
        </a>
        <p>Where I'll be writing my mind.</p>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "reading")}
          class="text-accent text-lg font-medium hover:underline"
        >
          Reading
        </a>
        <p>Books I am currently reading or have recently finished.</p>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "my-corner-of-fun")}
          class="text-accent text-lg font-medium hover:underline"
        >
          My Corner of Fun
        </a>
        <p>A collection of fun manga snapshots, quotes, and visuals.</p>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "fitness")}
          class="text-accent text-lg font-medium hover:underline"
        >
          Fitness
        </a>
        <p>My fitness journey and current routines.</p>
      </li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "now")}
          class="text-accent text-lg font-medium hover:underline"
        >
          Now
        </a>
        <p>What I am focused on at this exact moment in time.</p>
      </li>
    </ul>
  </Main>
  <Footer />
</Layout>
